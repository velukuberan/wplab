# ─── Local configuration / secrets ───────────
traefik/.env

# Local TLS certificates
traefik/certs/

# ─── Remote configuration / secrets ──────────
/config/remote.env
/config/remote.secrets.env

# Generated remote Traefik configuration
/traefik/remote/traefik.yml
/traefik/remote/dynamic.yml

traefik/dynamic/.ms-subdomain-tls.lock
traefik/dynamic/.ms-subdomain-tls.owner
traefik/dynamic/ms-subdomain-tls.yml

# Remote Let's Encrypt certificates and account state
/traefik/remote/letsencrypt/

# Dashboard authentication credentials
/traefik/remote/dashboard-users

# ─── Runtime state ───────────────────────────
# Live WordPress sites — user data, not infra code
sites/

# newsite/killsite event log
sites.log

# ─── Editor / OS junk ────────────────────────
*.swp
*.swo
.DS_Store
Thumbs.db
*~

# ─── Never commit these by accident ──────────
*.pem
*.key
*.crt
*_rsa
*_ed25519
