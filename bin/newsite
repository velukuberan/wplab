#!/usr/bin/env bash

set -euo pipefail

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WPLAB_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMPLATE_DIR="$WPLAB_ROOT/templates/wordpress"

# Sites are always generated relative to the directory from which newsite
# was invoked. The WP Lab repository location must not determine site location.
OUTPUT_ROOT="$PWD"

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
die() {
    echo "❌ $*" >&2
    exit 1
}

info() {
    echo "▶ $*"
}

ok() {
    echo "✅ $*"
}

# Generate a random string containing letters and digits while avoiding
# visually ambiguous characters.
randstr() {
    local len="$1"
    local raw

    raw="$(
        LC_ALL=C tr -dc 'A-HJ-NP-Za-km-z2-9' </dev/urandom 2>/dev/null |
            head -c "$len" || true
    )"

    printf '%s' "$raw"
}

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
command -v jq >/dev/null 2>&1 ||
    die "jq is required but not installed."

# -----------------------------------------------------------------------------
# Arguments
# -----------------------------------------------------------------------------
[[ $# -eq 1 ]] || die "Usage: newsite <config.json>"

CONFIG="$1"

[[ -f "$CONFIG" ]] ||
    die "Config file not found: $CONFIG"

[[ -r "$CONFIG" ]] ||
    die "Config file is not readable: $CONFIG"

jq empty "$CONFIG" 2>/dev/null ||
    die "Config file is not valid JSON: $CONFIG"

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
SITE="$(jq -r '.name // empty' "$CONFIG")"
WP_VERSION="$(jq -r '.wordpress // "latest"' "$CONFIG")"
PHP_VERSION="$(jq -r '.php // "8.3"' "$CONFIG")"
MARIADB_VERSION="$(jq -r '.mariadb // "11"' "$CONFIG")"

[[ -n "$SITE" ]] ||
    die "Config must define a site name."

# Site names become both directory names and part of the local hostname.
#
# Valid:
#   example
#   captcha
#   woo-100
#   wp-67-php81
#
# Invalid:
#   -example
#   example-
#   example--test
#   Example
#   example_test
[[ "$SITE" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
    die "Invalid site name '$SITE'. Use lowercase letters, numbers, and single hyphens."

SITE_DIR="$OUTPUT_ROOT/$SITE"

# -----------------------------------------------------------------------------
# Pre-generation validation
# -----------------------------------------------------------------------------
[[ -d "$TEMPLATE_DIR" ]] ||
    die "WordPress template not found: $TEMPLATE_DIR"

[[ -f "$TEMPLATE_DIR/docker-compose.yml.tmpl" ]] ||
    die "Docker Compose template not found: $TEMPLATE_DIR/docker-compose.yml.tmpl"

[[ -f "$TEMPLATE_DIR/.env.tmpl" ]] ||
    die "Environment template not found: $TEMPLATE_DIR/.env.tmpl"

[[ -f "$TEMPLATE_DIR/Dockerfile.tmpl" ]] ||
    die "Dockerfile template not found: $TEMPLATE_DIR/Dockerfile.tmpl"

[[ -f "$TEMPLATE_DIR/nginx/default.conf.tmpl" ]] ||
    die "Nginx config template not found: $TEMPLATE_DIR/nginx/default.conf.tmpl"

[[ -f "$TEMPLATE_DIR/Makefile.tmpl" ]] ||
    die "Makefile template not found: $TEMPLATE_DIR/Makefile.tmpl"

[[ ! -e "$SITE_DIR" ]] ||
    die "Site directory already exists: $SITE_DIR"

# -----------------------------------------------------------------------------
# Rollback
# -----------------------------------------------------------------------------
# Once generation starts, any failure should remove the partially generated
# directory. A failed newsite operation must not leave an incomplete project.
CLEANUP_ENABLED=false

cleanup_on_error() {
    local exit_code=$?

    if $CLEANUP_ENABLED &&
        [[ $exit_code -ne 0 ]] &&
        [[ -d "$SITE_DIR" ]]; then

        echo ""
        echo "⚠ Site generation failed. Removing partial site directory..."
        rm -rf "$SITE_DIR"
    fi
}

trap cleanup_on_error EXIT

# -----------------------------------------------------------------------------
# WordPress image
# -----------------------------------------------------------------------------
# Docker Hub WordPress image tags use different forms for "latest" and
# explicitly requested WordPress versions:
#
#   latest + PHP 8.3 -> wordpress:php8.3-fpm
#   6.7    + PHP 8.1 -> wordpress:6.7-php8.1-fpm
if [[ "$WP_VERSION" == "latest" ]]; then
    WP_IMAGE_TAG="php${PHP_VERSION}-fpm"
else
    WP_IMAGE_TAG="${WP_VERSION}-php${PHP_VERSION}-fpm"
fi

# -----------------------------------------------------------------------------
# Credentials
# -----------------------------------------------------------------------------
DB_PASSWORD="$(randstr 24)"
DB_ROOT_PASSWORD="$(randstr 24)"

ADMIN_USER="admin"
ADMIN_PASS="$(randstr 16)"
ADMIN_EMAIL="admin@${SITE}.wplab.test"

SITE_TITLE="$SITE"

# -----------------------------------------------------------------------------
# Generate site
# -----------------------------------------------------------------------------
info "Creating site '$SITE' at $SITE_DIR..."

# From this point onward, a failure must remove SITE_DIR.
CLEANUP_ENABLED=true

mkdir "$SITE_DIR"
mkdir -p "$SITE_DIR/nginx"
mkdir -p \
    "$SITE_DIR/plugins" \
    "$SITE_DIR/mu-plugins" \
    "$SITE_DIR/themes"

cp \
    "$TEMPLATE_DIR/docker-compose.yml.tmpl" \
    "$SITE_DIR/docker-compose.yml"

cp \
    "$TEMPLATE_DIR/.env.tmpl" \
    "$SITE_DIR/.env"

cp \
    "$TEMPLATE_DIR/Dockerfile.tmpl" \
    "$SITE_DIR/Dockerfile"

cp \
    "$TEMPLATE_DIR/nginx/default.conf.tmpl" \
    "$SITE_DIR/nginx/default.conf"

cp \
    "$TEMPLATE_DIR/Makefile.tmpl" \
    "$SITE_DIR/Makefile"

# -----------------------------------------------------------------------------
# Render Docker Compose template
# -----------------------------------------------------------------------------
sed -i \
    -e "s|__SITE__|$SITE|g" \
    "$SITE_DIR/docker-compose.yml"

# -----------------------------------------------------------------------------
# Render environment template
# -----------------------------------------------------------------------------
sed -i \
    -e "s|__SITE__|$SITE|g" \
    -e "s|__WP_VERSION__|$WP_VERSION|g" \
    -e "s|__PHP_VERSION__|$PHP_VERSION|g" \
    -e "s|__MARIADB_VERSION__|$MARIADB_VERSION|g" \
    -e "s|__DB_PASSWORD__|$DB_PASSWORD|g" \
    -e "s|__DB_ROOT_PASSWORD__|$DB_ROOT_PASSWORD|g" \
    -e "s|__ADMIN_USER__|$ADMIN_USER|g" \
    -e "s|__ADMIN_PASS__|$ADMIN_PASS|g" \
    -e "s|__ADMIN_EMAIL__|$ADMIN_EMAIL|g" \
    -e "s|__SITE_TITLE__|$SITE_TITLE|g" \
    "$SITE_DIR/.env"

# WP_IMAGE_TAG is calculated rather than directly represented by a template
# placeholder because it depends on both WordPress and PHP versions.
echo "WP_IMAGE_TAG=$WP_IMAGE_TAG" >>"$SITE_DIR/.env"

# The environment file contains generated credentials.
chmod 600 "$SITE_DIR/.env"

# -----------------------------------------------------------------------------
# Verify generated project
# -----------------------------------------------------------------------------
# No template placeholders should remain in generated files.
if
    grep -RqsE '__[A-Z_]+__' \
        "$SITE_DIR/docker-compose.yml" \
        "$SITE_DIR/.env" \
        "$SITE_DIR/Dockerfile" \
        "$SITE_DIR/nginx/default.conf" \
        "$SITE_DIR/Makefile"
then
    die "Generated site contains unresolved template placeholders."
fi

# Generation is now complete. From this point onward the generated project
# belongs to the user and must not be removed by the rollback trap.
CLEANUP_ENABLED=false

# -----------------------------------------------------------------------------
# Success
# -----------------------------------------------------------------------------
echo ""
ok "Site project generated."
echo ""
echo "  Name:       $SITE"
echo "  WordPress:  $WP_VERSION"
echo "  PHP:        $PHP_VERSION"
echo "  MariaDB:    $MARIADB_VERSION"
echo "  Image:      wordpress:$WP_IMAGE_TAG"
echo "  URL:        https://${SITE}.wplab.test"
echo "  Output:     $SITE_DIR"
echo ""
