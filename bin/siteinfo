#!/usr/bin/env bash
# List registered WPLab sites or show details for one site.
# Usage: siteinfo [name [--password-only]]
set -euo pipefail

fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }
usage() { printf 'Usage: siteinfo [name [--password-only]]\n' >&2; exit 2; }

command -v jq >/dev/null 2>&1 || fail 'jq is required'
[[ $# -le 2 ]] || usage
if [[ $# -eq 2 ]]; then
    [[ "$2" == '--password-only' ]] || usage
fi

REGISTRY="${XDG_CONFIG_HOME:-$HOME/.config}/wplab/sites.json"
if [[ ! -e "$REGISTRY" ]]; then
    [[ $# -eq 0 ]] && { echo 'No registered sites. Create one with: newsite <config.json>'; exit 0; }
    fail 'No global registry found'
fi
[[ -f "$REGISTRY" && ! -L "$REGISTRY" ]] || fail 'Registry must be a regular file'
jq -e 'type == "object" and all(to_entries[]; (.key | test("^[a-z0-9]+(-[a-z0-9]+)*$")) and (.value | type == "object") and (.value.path | type == "string" and startswith("/")))' "$REGISTRY" >/dev/null || fail 'Invalid registry JSON or structure'

# Parse plain KEY=VALUE without executing the contents of .env.
env_value() {
    local key="$1" file="$2" line
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$key="* ]]; then
            printf '%s' "${line#*=}"
            return 0
        fi
    done < "$file"
    return 1
}

site_path() { jq -r --arg name "$1" '.[$name].path // empty' "$REGISTRY"; }
site_state() {
    local name="$1" path="$2"
    if [[ ! -d "$path" || ! -f "$path/.env" ]]; then
        echo Missing
    elif ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
        echo Unknown
    elif docker ps --filter "label=com.docker.compose.project=$name" --format '{{.ID}}' | grep -q .; then
        echo Running
    else
        echo Stopped
    fi
}

if [[ $# -eq 0 ]]; then
    if [[ "$(jq 'length' "$REGISTRY")" == 0 ]]; then
        echo 'No registered sites. Create one with: newsite <config.json>'
        exit 0
    fi
    printf '%-20s %-10s %-38s %s\n' NAME STATUS URL PATH
    while IFS= read -r name; do
        path=$(site_path "$name")
        url='-'
        if [[ -f "$path/.env" ]]; then
            url=$(env_value SITE_URL "$path/.env") || url='-'
        fi
        printf '%-20s %-10s %-38s %s\n' "$name" "$(site_state "$name" "$path")" "$url" "$path"
    done < <(jq -r 'keys[]' "$REGISTRY")
    exit 0
fi

SITE="$1"
[[ "$SITE" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail 'Invalid site name'
SITE_DIR=$(site_path "$SITE")
[[ -n "$SITE_DIR" ]] || fail "Site '$SITE' is not registered"
[[ -d "$SITE_DIR" && -f "$SITE_DIR/.env" ]] || fail "Registered site '$SITE' is missing its directory or .env: $SITE_DIR"
ENV_FILE="$SITE_DIR/.env"
[[ "$(env_value SITE_NAME "$ENV_FILE")" == "$SITE" ]] || fail 'Registry and .env site names differ'

if [[ "${2:-}" == '--password-only' ]]; then
    env_value ADMIN_PASS "$ENV_FILE" || fail 'ADMIN_PASS is not set'
    exit 0
fi

get() { env_value "$1" "$ENV_FILE" || printf '-'; }
printf 'Site:       %s\n' "$SITE"
printf 'Status:     %s\n' "$(site_state "$SITE" "$SITE_DIR")"
printf 'URL:        %s\n' "$(get SITE_URL)"
printf 'Admin URL:  %s/wp-admin/\n' "$(get SITE_URL)"
printf 'WordPress:  %s\n' "$(get WP_VERSION)"
printf 'PHP:        %s\n' "$(get PHP_VERSION)"
printf 'MariaDB:    %s\n' "$(get MARIADB_VERSION)"
printf 'Multisite:  %s\n' "$(get MULTISITE_ENABLED)"
printf 'Admin user: %s\n' "$(get ADMIN_USER)"
printf 'Admin email:%s\n' " $(get ADMIN_EMAIL)"
printf 'Directory:  %s\n' "$SITE_DIR"
printf 'Password:   (hidden; use siteinfo %s --password-only)\n' "$SITE"
