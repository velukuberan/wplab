#!/usr/bin/env bash
#
# siteinfo — show info about a site, or list all sites
# Usage:
#   siteinfo                     List all sites
#   siteinfo <name>              Show full info for one site
#   siteinfo <name> --password-only   Print just the password (for piping)

set -euo pipefail

# -----------------------------------------------------------------------------
# Config
# -----------------------------------------------------------------------------
TESTLAB="/opt/testlab"
SITES="$TESTLAB/sites"

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
die() {
    echo "❌ $*" >&2
    exit 1
}

# Load KEY=VALUE file into shell variables (prefixed with $2)
load_env() {
    local file="$1"
    local prefix="${2:-}"
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" =~ ^# ]] && continue
        printf -v "${prefix}${key}" '%s' "$value"
    done <"$file"
}

# -----------------------------------------------------------------------------
# Mode: LIST (no args)
# -----------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
    if [[ ! -d "$SITES" || -z "$(ls -A "$SITES" 2>/dev/null)" ]]; then
        echo "No sites yet. Create one with: newsite <config.json>"
        exit 0
    fi

    printf "\n%-12s %-12s %-14s %-40s %s\n" "NAME" "TEMPLATE" "STATUS" "URL" "STACK"
    printf "%-12s %-12s %-14s %-40s %s\n" "----" "--------" "------" "---" "-----"

    for dir in "$SITES"/*/; do
        [[ -d "$dir" ]] || continue
        name="$(basename "$dir")"

        # Read env file for stack info
        env_file="$dir/.env"
        if [[ -f "$env_file" ]]; then
            wp_ver=$(grep '^WP_VERSION=' "$env_file" | cut -d= -f2)
            php_ver=$(grep '^PHP_VERSION=' "$env_file" | cut -d= -f2)
            url=$(grep '^SITE_URL=' "$env_file" | cut -d= -f2)
        else
            wp_ver="?"
            php_ver="?"
            url="?"
        fi

        # Detect template by finding a matching template folder (best effort — assume wordpress for now)
        template="wordpress"

        # Status check via docker
        if docker ps --filter "label=com.docker.compose.project=$name" --format '{{.Names}}' | grep -q .; then
            status="✅ Running"
        else
            status="⚠  Stopped"
        fi

        printf "%-12s %-12s %-14s %-40s %s\n" "$name" "$template" "$status" "$url" "WP $wp_ver · PHP $php_ver"
    done
    echo ""
    exit 0
fi

# -----------------------------------------------------------------------------
# Mode: SINGLE SITE
# -----------------------------------------------------------------------------
SITE="$1"
PASSWORD_ONLY=false

if [[ "${2:-}" == "--password-only" ]]; then
    PASSWORD_ONLY=true
fi

SITE_DIR="$SITES/$SITE"
[[ -d "$SITE_DIR" ]] || die "Site '$SITE' does not exist"

CREDS_FILE="$SITE_DIR/.credentials"
ENV_FILE="$SITE_DIR/.env"

[[ -f "$CREDS_FILE" ]] || die "No credentials file found at $CREDS_FILE"
[[ -f "$ENV_FILE" ]] || die "No env file found at $ENV_FILE"

# Load both files with prefixes to avoid var name collisions
load_env "$CREDS_FILE" "C_"
load_env "$ENV_FILE" "E_"

# Password-only mode: just print and exit
if $PASSWORD_ONLY; then
    printf '%s' "$C_ADMIN_PASS"
    exit 0
fi

# -----------------------------------------------------------------------------
# Full info mode
# -----------------------------------------------------------------------------

# Status
if docker ps --filter "label=com.docker.compose.project=$SITE" --format '{{.Names}}' | grep -q .; then
    status="✅ Running"
    # Get uptime from one of the containers
    uptime=$(docker ps --filter "label=com.docker.compose.project=$SITE" --format '{{.Status}}' | head -1)
else
    status="⚠  Stopped"
    uptime="(not running)"
fi

# Container list
containers=$(docker ps -a --filter "label=com.docker.compose.project=$SITE" \
    --format '{{.Names}} ({{.Status}})' | paste -sd ', ' -)

# Volume list
volumes=$(docker volume ls --filter "label=com.docker.compose.project=$SITE" \
    --format '{{.Name}}' | paste -sd ', ' -)

echo ""
echo "📦 Site: $SITE"
echo ""
echo "   Status:      $status ($uptime)"
echo "   URL:         $C_SITE_URL"
echo "   Admin URL:   $C_ADMIN_URL"
echo ""
echo "   Stack:       WordPress $E_WP_VERSION · PHP $E_PHP_VERSION · MariaDB $E_MARIADB_VERSION"
echo ""
echo "   🔐 Admin login"
echo "      Username: $C_ADMIN_USER"
echo "      Password: $C_ADMIN_PASS"
echo "      Email:    $C_ADMIN_EMAIL"
echo ""
echo "   📂 Location"
echo "      Site dir:   $SITE_DIR"
echo "      Containers: $containers"
echo "      Volumes:    $volumes"
echo ""
echo "   📅 Created:  $C_CREATED_AT"
echo ""
