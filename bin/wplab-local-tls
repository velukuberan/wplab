#!/usr/bin/env bash
# WPL-021: local-only, per-multisite mkcert certificate management.
set -euo pipefail

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
[[ $# -eq 3 ]] || fail 'Usage: wplab-local-tls provision|cleanup <site> <domain>'
action=$1 site=$2 domain=$3
[[ "$action" == provision || "$action" == cleanup ]] || fail 'Unsupported action'
[[ "$site" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail 'Invalid site name'
[[ ${#domain} -le 253 && "$domain" =~ ^[a-z0-9]+([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]+([a-z0-9-]*[a-z0-9])?)+$ ]] || fail 'Invalid domain'
IFS='.' read -r -a labels <<< "$domain"
for label in "${labels[@]}"; do [[ ${#label} -le 63 ]] || fail 'Domain label too long'; done

script=$(realpath -e -- "${BASH_SOURCE[0]}") || fail 'Cannot resolve helper path'
root=$(dirname -- "$(dirname -- "$script")")
cert_dir="$root/traefik/certs"
dynamic_dir="$root/traefik/dynamic"
host="$site.$domain"
cert="$cert_dir/$host.pem"
key="$cert_dir/$host-key.pem"
config="$dynamic_dir/$site-tls.yml"

# Do not follow symlinks or operate on resources outside our checkout.
for dir in "$root/traefik" "$cert_dir" "$dynamic_dir"; do
    [[ -d "$dir" && ! -L "$dir" ]] || fail "Missing or unsafe directory: $dir"
done
for file in "$cert" "$key" "$config"; do
    [[ ! -L "$file" ]] || fail "Refusing symlink: $file"
done

# A per-site lock prevents concurrent provision/cleanup calls racing.
command -v flock >/dev/null || fail 'flock is required'
lock="$dynamic_dir/.$site-tls.lock"
[[ ! -L "$lock" ]] || fail 'Unsafe TLS lock'
exec 9>"$lock"
flock -x 9

if [[ "$action" == provision ]]; then
    for file in "$cert" "$key" "$config"; do
        [[ ! -L "$file" ]] || fail "Refusing symlink: $file"
    done
    if [[ -e "$cert" || -e "$key" || -e "$config" ]]; then
        [[ -s "$cert" && -s "$key" && -s "$config" && -f "$cert" && -f "$key" && -f "$config" ]] || fail 'Partial TLS resources; refusing to overwrite'
        expected=$(printf 'tls:\n  certificates:\n    - certFile: /certs/%s.pem\n      keyFile: /certs/%s-key.pem\n' "$host" "$host")
        [[ "$(cat -- "$config")" == "$expected" ]] || fail 'Existing TLS registration differs; refusing to overwrite'
        printf 'Existing local TLS resources preserved: %s\n' "$host"
        exit 0
    fi
    command -v mkcert >/dev/null || fail 'mkcert is required'
    umask 077
    cert_tmp=$(mktemp "$cert_dir/.$site-cert.XXXXXXXX") || fail 'Cannot stage certificate'
    key_tmp=$(mktemp "$cert_dir/.$site-key.XXXXXXXX") || fail 'Cannot stage key'
    config_tmp=$(mktemp "$dynamic_dir/.$site-tls.XXXXXXXX") || fail 'Cannot stage Traefik registration'
    cleanup_tmp() { rm -f -- "$cert_tmp" "$key_tmp" "$config_tmp"; }
    trap cleanup_tmp EXIT
    mkcert -cert-file "$cert_tmp" -key-file "$key_tmp" "$host" "*.$host" || fail 'mkcert failed'
    [[ -s "$cert_tmp" && -s "$key_tmp" ]] || fail 'mkcert wrote empty certificate/key'
    chmod 644 "$cert_tmp"
    chmod 600 "$key_tmp"
    printf 'tls:\n  certificates:\n    - certFile: /certs/%s.pem\n      keyFile: /certs/%s-key.pem\n' "$host" "$host" > "$config_tmp"
    chmod 644 "$config_tmp"
    # Publish the configuration last to avoid Traefik loading an incomplete pair.
    [[ ! -e "$cert" && ! -e "$key" && ! -e "$config" ]] || fail 'TLS resources appeared during provisioning'
    mv -n -- "$cert_tmp" "$cert" || fail 'Could not publish certificate'
    mv -n -- "$key_tmp" "$key" || { rm -f -- "$cert"; fail 'Could not publish key'; }
    mv -n -- "$config_tmp" "$config" || { rm -f -- "$cert" "$key"; fail 'Could not publish registration'; }
    trap - EXIT
    printf 'Provisioned local TLS resources: %s\n' "$host"
else
    # Cleanup requires a matching registration, so unmanaged certs are never deleted.
    if [[ ! -e "$cert" && ! -e "$key" && ! -e "$config" ]]; then
        printf 'No local TLS resources to clean: %s\n' "$host"
        exit 0
    fi
    [[ -f "$config" && ! -L "$config" ]] || fail 'Missing or unsafe managed registration; refusing cleanup'
    expected=$(printf 'tls:\n  certificates:\n    - certFile: /certs/%s.pem\n      keyFile: /certs/%s-key.pem\n' "$host" "$host")
    [[ "$(cat -- "$config")" == "$expected" ]] || fail 'TLS registration differs; refusing cleanup'
    for file in "$cert" "$key"; do
        [[ -f "$file" && ! -L "$file" ]] || fail 'Missing or unsafe certificate resource; refusing cleanup'
    done
    rm -f -- "$config" "$cert" "$key" || fail 'Could not clean TLS resources'
    printf 'Cleaned local TLS resources: %s\n' "$host"
fi
