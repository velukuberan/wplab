# WPLab remote server configuration
# Copy this file to remote.env and customize it.

# Required: public base domain for WordPress test sites
WPLAB_DOMAIN=test.example.com

# Required: email address for Let's Encrypt
WPLAB_ACME_EMAIL=admin@example.com

# Remote DNS provider.
# Supported: digitalocean
# Future providers will be implemented as separate adapters.
WPLAB_DNS_PROVIDER=digitalocean
