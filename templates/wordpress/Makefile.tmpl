ifneq (,$(wildcard .env))
include .env
export
endif

.PHONY: help up build rebuild down restart logs shell wp composer status clean info

HOST_UID := $(shell id -u)
HOST_GID := $(shell id -g)

DEV_EXEC := docker compose exec \
	--user "$(HOST_UID):$(HOST_GID)" \
	--env HOME=/tmp/wplab-dev-$(HOST_UID)

THEME_DIRS := $(patsubst %/,%,$(wildcard themes/*/))
THEMES := $(notdir $(THEME_DIRS))

PLUGINS := $(notdir $(wildcard plugins/*))
MU_PLUGINS := $(notdir $(wildcard mu-plugins/*))

SHELL_THEME_TARGETS := $(addprefix shell.theme.,$(THEMES))
SHELL_PLUGIN_TARGETS := $(addprefix shell.plugin.,$(PLUGINS))
SHELL_MU_PLUGIN_TARGETS := $(addprefix shell.mu-plugin.,$(MU_PLUGINS))

SHELL_SHORT_TARGETS := $(sort \
	$(addprefix shell.,$(THEMES)) \
	$(addprefix shell.,$(PLUGINS)) \
	$(addprefix shell.,$(MU_PLUGINS)))

$(SHELL_SHORT_TARGETS):
	@name='$(patsubst shell.%,%,$@)'; \
	matches=0; \
	workdir=''; \
	if [ -d "themes/$$name" ]; then \
		matches=$$((matches + 1)); \
		workdir="/workspace/themes/$$name"; \
	fi; \
	if [ -d "plugins/$$name" ]; then \
		matches=$$((matches + 1)); \
		workdir="/workspace/plugins/$$name"; \
	elif [ -f "plugins/$$name" ]; then \
		matches=$$((matches + 1)); \
		workdir="/workspace/plugins"; \
	fi; \
	if [ -d "mu-plugins/$$name" ]; then \
		matches=$$((matches + 1)); \
		workdir="/workspace/mu-plugins/$$name"; \
	elif [ -f "mu-plugins/$$name" ]; then \
		matches=$$((matches + 1)); \
		workdir="/workspace/mu-plugins"; \
	fi; \
	if [ "$$matches" -eq 0 ]; then \
		echo "Project not found: $$name"; \
		exit 1; \
	fi; \
	if [ "$$matches" -gt 1 ]; then \
		echo "Ambiguous project: $$name"; \
		echo "Use an explicit target:"; \
		[ -d "themes/$$name" ] && echo "  make shell.theme.$$name" || true; \
		[ -e "plugins/$$name" ] && echo "  make shell.plugin.$$name" || true; \
		[ -e "mu-plugins/$$name" ] && echo "  make shell.mu-plugin.$$name" || true; \
		exit 1; \
	fi; \
	$(DEV_EXEC) \
		-w "$$workdir" \
		wordpress env PS1='\w\$$ ' bash --noprofile --norc -i

$(SHELL_THEME_TARGETS):
	@$(DEV_EXEC) \
		-w /workspace/themes/$(patsubst shell.theme.%,%,$@) \
		wordpress env PS1='\w\$$ ' bash --noprofile --norc -i

$(SHELL_PLUGIN_TARGETS):
	@name='$(patsubst shell.plugin.%,%,$@)'; \
	if [ -d "plugins/$$name" ]; then \
		workdir="/workspace/plugins/$$name"; \
	elif [ -f "plugins/$$name" ]; then \
		workdir="/workspace/plugins"; \
	else \
		echo "Plugin not found: $$name"; \
		exit 1; \
	fi; \
	$(DEV_EXEC) \
		-w "$$workdir" \
		wordpress env PS1='\w\$$ ' bash --noprofile --norc -i

$(SHELL_MU_PLUGIN_TARGETS):
	@name='$(patsubst shell.mu-plugin.%,%,$@)'; \
	if [ -d "mu-plugins/$$name" ]; then \
		workdir="/workspace/mu-plugins/$$name"; \
	elif [ -f "mu-plugins/$$name" ]; then \
		workdir="/workspace/mu-plugins"; \
	else \
		echo "MU plugin not found: $$name"; \
		exit 1; \
	fi; \
	$(DEV_EXEC) \
		-w "$$workdir" \
		wordpress env PS1='\w\$$ ' bash --noprofile --norc -i

