services:
  db:
    image: mariadb:${MARIADB_VERSION}
    container_name: __SITE__-db
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: wordpress
      MARIADB_USER: wordpress
      MARIADB_PASSWORD: ${DB_PASSWORD}
      MARIADB_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - internal

  wordpress:
    build:
      context: .
      args:
        WP_IMAGE: wordpress:${WP_IMAGE_TAG}
    container_name: __SITE__-wp
    restart: unless-stopped
    depends_on:
      - db
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_NAME: wordpress
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: ${DB_PASSWORD}
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_AUTO_UPDATE_CORE', false);
        define('AUTOMATIC_UPDATER_DISABLED', true);
        
        if (!defined('WP_DEBUG')) {
            define('WP_DEBUG', true);
        }
        
        if (!defined('WP_DEBUG_LOG')) {
            define('WP_DEBUG_LOG', true);
        }
        
        if (!defined('WP_DEBUG_DISPLAY')) {
            define('WP_DEBUG_DISPLAY', false);
        }
    volumes:
      - wp_files:/var/www/html
      - ./plugins:/workspace/plugins
      - ./mu-plugins:/workspace/mu-plugins
      - ./themes:/workspace/themes
    networks:
      - internal

  nginx:
    image: nginx:alpine
    container_name: __SITE__-nginx
    restart: unless-stopped
    depends_on:
      - wordpress
    volumes:
      - wp_files:/var/www/html:ro
      - ./plugins:/workspace/plugins:ro
      - ./mu-plugins:/workspace/mu-plugins:ro
      - ./themes:/workspace/themes:ro
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - internal
      - web
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=web"
      - "traefik.http.routers.__SITE__.rule=Host(`__SITE__.wplab.test`)"
      - "traefik.http.routers.__SITE__.entrypoints=websecure"
      - "traefik.http.routers.__SITE__.tls=true"
      - "traefik.http.services.__SITE__.loadbalancer.server.port=80"

volumes:
  db_data:
  wp_files:

networks:
  internal:
  web:
    external: true
