api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":443"

providers:
  docker:
    endpoint: "tcp://socket-proxy:2375"
    exposedByDefault: false
    network: web
    constraints: "Label(`wplab.managed`, `true`)"

  file:
    filename: /etc/traefik/dynamic.yml
    watch: true

certificatesResolvers:
  dnsresolver:
    acme:
      email: "${WPLAB_ACME_EMAIL}"
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: "${WPLAB_DNS_PROVIDER}"
        propagation:
          delayBeforeChecks: 120s

log:
  level: INFO

accessLog: {}
